# Build caches for the vendored data. The *outputs* are checked in or
# regenerated by scripts/; the source archives they were built from are not.
engine/data/ephe/_cache/
engine/data/geo/_cache/

# 63 MB, and reproducible byte-for-byte from cities500 by scripts/build_geo.py.
engine/data/geo/places.sqlite

# Renders. Deterministic, so there is nothing here that cannot be remade.
out/

# Secrets never enter this repo; the private ops repo is a sibling checkout.
.env

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store
