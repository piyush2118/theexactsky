# Caddy gets the certificate on its own and does the rate limiting the plan asks
# for at the edge, so the app stays a single process with no middleware.

{$SKURIOUS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The page loads nothing from anywhere else, so say so.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}

	# Cards are a pure function of their URL, so they can be cached forever by
	# anything between here and the reader.
	@card path_regexp ^/c/[A-Za-z0-9_-]+\.(png|svg)$
	header @card Cache-Control "public, max-age=31536000, immutable"

	@static path /static/*
	header @static Cache-Control "public, max-age=604800"

	reverse_proxy app:8000

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# The plan does not store IP addresses, and neither does the log.
		format json
	}
}
